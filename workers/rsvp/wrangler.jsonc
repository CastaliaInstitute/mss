{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mss-rsvp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [{"pattern": "rsvp.castalia.institute", "custom_domain": true}],
  "vars": {
    "ALLOWED_ORIGIN": "https://mss.castalia.institute",
    "CALDAV_COLLECTION_URL": "https://cal.castalia.institute/custodian/mss-rsvps/",
    "CALDAV_USER": "mss-rsvp",
    "RECIPIENT": "custodian@castalia.institute",
    "FEED_URL": "https://mss.castalia.institute/MSS.ics"
  },
  "durable_objects": {"bindings": [{"name": "RSVPS", "class_name": "RsvpRecord"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RsvpRecord"]}],
  "ratelimits": [{"name": "RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}],
  "observability": {"enabled": false}
}
